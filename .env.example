# ---------------------------------------------------------------------------
# Niaga Analytics — configuration
#
# The app runs with none of this set: every store falls back to deterministic
# sample data, clearly labelled in the UI. Add credentials below to switch
# individual routes over to live marketplace data.
#
# IMPORTANT DATA MODEL
# - Competitor/public storefront analytics: use public pages through the
#   scraping gateway or Apify. Official seller APIs generally do NOT grant
#   arbitrary competitor-store access.
# - Stores you own / are authorised to access: prefer the official marketplace
#   APIs when credentials and seller authorisation are available.
# ---------------------------------------------------------------------------

# --- Scraping transport ----------------------------------------------------
# Comma-separated, in preference order. Anything without credentials is
# skipped automatically. Default: "direct" plus every provider with a key.
#   direct | scraperapi | scrapingbee | zenrows | brightdata
SCRAPE_PROVIDER=direct,scraperapi

# Exit-node country. Indonesian marketplaces gate hard on this — leave as `id`.
SCRAPE_COUNTRY=id

# Pick ONE provider to start with.
SCRAPERAPI_KEY=
SCRAPINGBEE_KEY=
ZENROWS_KEY=
# Full proxy URI, e.g. http://brd-customer-XXX-zone-unblocker:PASSWORD@brd.superproxy.io:22225
BRIGHTDATA_PROXY_URL=

# --- Shopee public storefront ---------------------------------------------
# Optional but strongly recommended for competitor/public-store analysis.
# Shopee's storefront JSON endpoints can answer without auth but rate-limit
# hard. A browser session cookie improves reliability.
SHOPEE_COOKIE=

# --- Shopee Open Platform --------------------------------------------------
# Official API credentials are for shops you own / are authorised for.
# Register an app in Shopee Open Platform and complete shop authorisation.
# These values are intentionally separate from public competitor scraping.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_ACCESS_TOKEN=
SHOPEE_SHOP_ID=
SHOPEE_OPEN_API_BASE=https://partner.shopeemobile.com

# --- TikTok Shop / Shop Tokopedia -----------------------------------------
# Route 1 — official Open API. Exact numbers, but only for a shop you own.
# Register at https://partner.tiktokshop.com, create an app, authorise your
# shop, then exchange the auth code for an access token.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
# From /authorization/202309/shops — required for shop-scoped endpoints.
TIKTOK_SHOP_CIPHER=
# Regional gateway. Leave unset for the global default.
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com

# In Indonesia, Tokopedia & Shop seller integrations are converging on the
# TikTok Shop partner APIs. Do not treat this as an unrestricted competitor API.

# --- Public catalogue fallback via Apify ----------------------------------
# Useful for public competitor data when direct storefront requests are blocked.
APIFY_TOKEN=
APIFY_TIKTOK_SHOP_ACTOR=novi~tiktok-shop-scraper
APIFY_TIKTOK_PROFILE_ACTOR=clockworks~tiktok-scraper
APIFY_SHOPEE_ACTOR=easyapi~shopee-product-scraper
APIFY_TOKOPEDIA_ACTOR=easyapi~tokopedia-product-scraper

# --- Behaviour -------------------------------------------------------------
MAX_PRODUCTS=240
CACHE_TTL_SECONDS=900

# Set to "false" to surface upstream errors instead of falling back to sample
# data when live access fails. Useful in CI/debugging.
ALLOW_SAMPLE_FALLBACK=true
