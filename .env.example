# ---------------------------------------------------------------------------
# Niaga Analytics — configuration
#
# READ THIS FIRST: with none of this set the app cannot return real numbers,
# and it will refuse rather than invent them — an analysis will fail with a
# setup panel explaining what to add. That is deliberate. Fabricated revenue
# figures are indistinguishable from real ones on screen, and people make
# purchasing and pricing decisions from this.
#
# Set ONE provider key below and real data starts flowing.
# ---------------------------------------------------------------------------

# --- Scraping transport ----------------------------------------------------
# Comma-separated, in preference order. Anything without credentials is
# skipped automatically. Default: "direct" plus every provider with a key.
#   direct | scraperapi | scrapingbee | zenrows | brightdata
SCRAPE_PROVIDER=direct,scraperapi

# Exit-node country. Indonesian marketplaces gate hard on this — leave as `id`.
SCRAPE_COUNTRY=id

# Pick ONE provider to start with. All of them offer a free tier.
#   ScraperAPI   https://www.scraperapi.com   (~5k free credits)
#   ScrapingBee  https://www.scrapingbee.com  (~1k free credits)
#   ZenRows      https://www.zenrows.com      (~1k free credits)
#   Bright Data  https://brightdata.com       (Web Unlocker, paid)
SCRAPERAPI_KEY=
SCRAPINGBEE_KEY=
ZENROWS_KEY=
# Full proxy URI, e.g. http://brd-customer-XXX-zone-unblocker:PASSWORD@brd.superproxy.io:22225
BRIGHTDATA_PROXY_URL=

# Covers Shopee, Tokopedia, Blibli, Lazada and Bukalapak.

# --- Shopee ----------------------------------------------------------------
# Optional but strongly recommended. Shopee's /api/v4 endpoints answer without
# auth, yet a real logged-out session cookie lifts most of the rate limits.
# Grab it from a browser: devtools → Network → any shopee.co.id request →
# copy the whole `cookie` request header.
SHOPEE_COOKIE=

# --- TikTok Shop -----------------------------------------------------------
# Route 1 — official Open API. Exact numbers, but only for a shop you own.
# Register at https://partner.tiktokshop.com, create an app, authorise your
# shop, then exchange the auth code for an access token.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
# From /authorization/202309/shops — required for shop-scoped endpoints.
TIKTOK_SHOP_CIPHER=
# Regional gateway. Leave unset for the global default.
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com

# Route 2 — Apify actors. Public catalogue data for ANY seller, no ownership
# needed. https://console.apify.com/account/integrations
APIFY_TOKEN=
# Override if an actor is renamed or you prefer a different one.
APIFY_TIKTOK_SHOP_ACTOR=novi~tiktok-shop-scraper
APIFY_TIKTOK_PROFILE_ACTOR=clockworks~tiktok-scraper
APIFY_SHOPEE_ACTOR=easyapi~shopee-product-scraper
APIFY_TOKOPEDIA_ACTOR=easyapi~tokopedia-product-scraper

# --- Behaviour -------------------------------------------------------------
# Listings pulled per store before the scraper stops paging.
MAX_PRODUCTS=240

# How long an analysis stays cached in process memory.
CACHE_TTL_SECONDS=900

# Serve deterministic SAMPLE data when a live fetch fails, instead of raising
# an error. Off by default and intended only for a public demo deployment
# where nobody acts on the figures. Everything it produces is labelled as
# sample in the UI and scored zero confidence.
#
# Never enable this on an instance anyone makes decisions from.
DEMO_MODE=false
